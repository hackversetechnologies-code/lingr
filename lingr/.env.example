# ============================================
# LINGR — Environment Variables
# Copy to .env.local and fill in all values
# ============================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Supabase (Auth + Database + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=https://qiogcutevuoxoogimeap.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFpb2djdXRldnVveG9vZ2ltZWFwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzE1MTI1MDEsImV4cCI6MjA4NzA4ODUwMX0.wANTijdb8hWMf2uk9qtbayfw-77UMBOVCte-Z2lUT7w
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFpb2djdXRldnVveG9vZ2ltZWFwIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3MTUxMjUwMSwiZXhwIjoyMDg3MDg4NTAxfQ.rktxfOTdwVNTnDoZMPax-rk58GlQdiZCNgYwf9xW5Z4
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database (Direct Postgres for pgvector) ---
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_URL_POOLED=postgresql://postgres.your-project:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# --- AI Providers (fallback chain: Claude -> OpenAI -> Gemini -> Grok) ---
ANTHROPIC_API_KEY=sk-ant-your-key
OPENAI_API_KEY=sk-your-openai-key
GOOGLE_AI_API_KEY=your-gemini-api-key
GROK_API_KEY=your-grok-api-key
GROK_BASE_URL=https://api.x.ai/v1

# --- TTS Providers (fallback chain: Google -> OpenAI -> Cartesia -> ElevenLabs) ---
# Google Cloud TTS
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
# Cartesia
CARTESIA_API_KEY=your-cartesia-key
# ElevenLabs (premium fallback)
ELEVENLABS_API_KEY=your-elevenlabs-key

# --- STT Providers (fallback chain: OpenAI Whisper -> Google -> Deepgram) ---
# OpenAI Whisper (reuses OPENAI_API_KEY above)
# Google Cloud Speech (reuses GOOGLE_APPLICATION_CREDENTIALS_JSON above)
DEEPGRAM_API_KEY=your-deepgram-key

# --- Supabase Storage (replaces S3/R2) ---
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1
SUPABASE_STORAGE_BUCKET_AUDIO=lingr-audio
SUPABASE_STORAGE_BUCKET_AVATARS=lingr-avatars

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-stripe-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PLUS_PRICE_ID=price_your-plus-price-id
STRIPE_PRO_PRICE_ID=price_your-pro-price-id

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/webhooks/telegram

# --- Push Notifications (VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_EMAIL=mailto:hello@yourdomain.com

# --- App Security ---
NEXTAUTH_SECRET=your-random-32-char-secret-for-sessions
CRON_SECRET=your-random-cron-secret
